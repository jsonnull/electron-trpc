{
  "name": "electron-trpc",
  "description": "Electron support for tRPC",
  "version": "1.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsonnull/electron-trpc.git"
  },
  "homepage": "https://electron-trpc.dev",
  "bugs": {
    "url": "https://github.com/jsonnull/electron-trpc/issues"
  },
  "keywords": [
    "electron",
    "trpc",
    "ipc",
    "rpc",
    "typescript"
  ],
  "exports": {
    "./main": {
      "webpack": "./dist/main.mjs",
      "import": {
        "types": "./dist/main.d.mts",
        "default": "./dist/main.mjs"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/main.cjs"
      }
    },
    "./preload": {
      "import": {
        "types": "./dist/preload.d.mts",
        "default": "./dist/preload.mjs"
      },
      "require": {
        "types": "./dist/preload.d.cts",
        "default": "./dist/preload.cjs"
      }
    },
    "./preload-auto": "./dist/preload-auto.cjs",
    "./renderer": {
      "import": {
        "types": "./dist/renderer.d.mts",
        "default": "./dist/renderer.mjs"
      },
      "require": {
        "types": "./dist/renderer.d.cts",
        "default": "./dist/renderer.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "author": "Jason Nall <jsonnull@gmail.com>",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "typecheck": "tsc -b",
    "copy:readme": "cp ../../README.md ./",
    "prepublishOnly": "pnpm copy:readme && pnpm build"
  },
  "devDependencies": {
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.9.0",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.1.0",
    "superjson": "^2.2.6",
    "tsdown": "0.23.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@trpc/client": "^11.10.0",
    "@trpc/server": "^11.10.0",
    "electron": ">=35.0.0"
  },
  "dependencies": {
    "debug": "^4.4.3"
  }
}
